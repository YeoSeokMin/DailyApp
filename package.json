{
  "name": "app-idea-reporter",
  "version": "1.0.0",
  "description": "iOS/Android 앱스토어에서 아이디어 좋은 앱을 수집하여 리포트하는 시스템",
  "main": "scripts/collect.js",
  "scripts": {
    "collect": "node scripts/collect.js",
    "analyze": "node scripts/analyze.js",
    "save": "node scripts/save-report.js",
    "kakao:auth": "node scripts/kakao-auth.js",
    "kakao:send": "node scripts/send-kakao.js",
    "daily": "bash run-pipeline.sh",
    "test:reliability": "node --test tests/*.test.cjs"
  },
  "keywords": [
    "app",
    "idea",
    "reporter",
    "appstore",
    "playstore"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "axios": "^1.6.0",
    "cheerio": "^1.1.2",
    "dotenv": "^16.3.0",
    "google-play-scraper": "^9.1.0",
    "puppeteer-core": "25.12.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
